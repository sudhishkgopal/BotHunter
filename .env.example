# BotHunter Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
# DATABASE_URL=sqlite:///bothunter.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/bothunter

# ── AI Provider ────────────────────────────────────────────────────────────
# Provider: openai | gemini | anthropic | ollama
AI_PROVIDER=openai

# API key for the chosen provider
# OpenAI:     https://platform.openai.com/api-keys
# Gemini:     https://aistudio.google.com/app/apikey
# Anthropic:  https://console.anthropic.com/settings/keys
AI_API_KEY=sk-...

# Model to use for node explanations
# OpenAI:    gpt-4o-mini  (cheap) | gpt-4o  (best)
# Gemini:    gemini-1.5-flash | gemini-1.5-pro
# Anthropic: claude-3-haiku-20240307
# Ollama:    llama3 (local, no key needed)
AI_MODEL=gpt-4o-mini

# Enable AI-powered explanations in the dashboard (true/false)
AI_ENABLED=true

# ── Ollama (local AI only) ─────────────────────────────────────────────────
# If AI_PROVIDER=ollama, set the Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# ── API Security ───────────────────────────────────────────────────────────
# Secret key used for API request signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI server.
# Default (local dev): the Streamlit dashboard running on port 8501.
# In production: set this to the exact origin(s) of your frontend (no trailing slash).
# Example (multiple origins): http://localhost:8501,https://yourdomain.com
# NOTE: do NOT use * here — the API does not send credentials, but explicit
#       origins are required for any browser that enforces strict CORS policies.
CORS_ORIGINS=http://localhost:8501

# ── App Mode ───────────────────────────────────────────────────────────────
# Controls which service Docker starts: dashboard | api | both
APP_MODE=dashboard
